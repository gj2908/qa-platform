# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never expose to the browser

# Web push (VAPID) — optional, degrades to a no-op when unset (see
# lib/pushSend.js). Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=          # server-only, never expose to the browser
VAPID_SUBJECT=mailto:you@example.com
